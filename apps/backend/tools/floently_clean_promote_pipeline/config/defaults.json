{
  "pipeline_version": 18,
  "ai": {
    "default_model": "gpt-4o-mini",
    "temperature": 0.0,
    "max_sample_items_for_batch_verify": 8,
    "request_timeout_seconds": 12,
    "batch_recover_size": 25,
    "max_recover_items_per_batch": 40,
    "recover_only_below_confidence": 0.5,
    "skip_recover_for_explicit_clean_batches": true,
    "skip_batch_verify_for_explicit_clean_batches": true
  },
  "thresholds": {
    "min_quality_score": 0.6,
    "min_manifest_confidence": 0.5,
    "min_extraction_confidence": 0.55,
    "min_validation_score": 0.7,
    "max_term_length": 80,
    "max_sentence_length": 320,
    "max_pattern_length": 120
  },
  "defaults": {
    "language": "fi",
    "level_band": "B1_B2",
    "profession": "none",
    "domain": "general_finnish",
    "path": "general",
    "difficulty": "core",
    "progress_interval_seconds": 1.0,
    "incremental_scan_enabled": true,
    "large_auxiliary_skip_threshold": 2000,
    "large_auxiliary_skip_name_hints": [
      "generated_cards",
      "filtered_cards",
      "enriched_cards",
      "vocabulary_full",
      "yki_exercises"
    ]
  },
  "global_dedupe": {
    "enabled": false,
    "paths": [],
    "cross_batch_within_run": true
  }
}