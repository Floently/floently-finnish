# Floently Finnish backend production environment template
# Copy to apps/backend/.env on the target host and fill with real values.

APP_ENV=production
FLOENTLY_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8080
HOST=0.0.0.0

# Required secrets
SIGNED_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Public URLs
PUBLIC_BASE_URL=https://learn-api.floently.com
CORS_ALLOW_ORIGINS=https://app.floently.com,https://www.floently.com
TRUSTED_HOSTS=learn-api.floently.com,localhost,127.0.0.1

# Database
# Example: postgresql+asyncpg://user:password@db-host:5432/floently
DATABASE_URL=sqlite+aiosqlite:///./puhis.db
ALLOW_ORM_CREATE_ALL=false
# For state-store auth/session persistence when using Docker volume mounts.
STATE_STORE_PATH=/app/runtime/state.json
# Comma-separated test accounts that should always get internal all-access entitlements.
INTERNAL_ALL_ACCESS_TEST_EMAILS=
REQUIRE_EMAIL_VERIFICATION=true
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_EMAIL=3
REGISTER_RATE_LIMIT_PER_IP=10
# Optional CAPTCHA verification for signup.
SIGNUP_CAPTCHA_SECRET=
SIGNUP_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Voice/STT/TTS
OPENAI_API_KEY=CHANGE_ME
OPENAI_TTS_ENABLED=true
GOOGLE_TTS_ENABLED=true
GOOGLE_STT_CREDENTIALS_PATH=/opt/floently/secrets/google-stt-service-account.json
GOOGLE_TTS_CREDENTIALS_PATH=/opt/floently/secrets/google-tts-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/opt/floently/secrets/google-tts-service-account.json
TTS_DEFAULT_PROVIDER=google
TTS_FALLBACK_PROVIDER=openai

# Billing
# If you sell digital subscriptions in mobile apps, in-app billing policy review is required.
BILLING_CHECKOUT_BASE_URL=
BILLING_PORTAL_BASE_URL=

# Optional observability
ENABLE_REQUEST_LOGGING=false
ENABLE_TTS_LOGGING=false
