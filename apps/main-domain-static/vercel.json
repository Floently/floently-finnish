    {
      "source": "/account-deletion",
      "destination": "https://www.kielivalmis.com/delete-account",
      "permanent": true
    },
    {
      "source": "/learn/delete-account",
      "destination": "https://www.kielivalmis.com/delete-account",
      "permanent": true
    },
    {
      "source": "/learn/account-deletion",
      "destination": "https://www.kielivalmis.com/delete-account",
      "permanent": true
    },
    {
      "source": "/legal/account-deletion",
      "destination": "https://www.kielivalmis.com/delete-account",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
