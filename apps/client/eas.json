{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "/learn/privacy",
        "EXPO_PUBLIC_TERMS_URL": "/learn/terms",
        "EXPO_PUBLIC_SUPPORT_URL": "/learn/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "/learn/delete-account"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "/learn/privacy",
        "EXPO_PUBLIC_TERMS_URL": "/learn/terms",
        "EXPO_PUBLIC_SUPPORT_URL": "/learn/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "/learn/delete-account"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "beta"
      }
    }
  }
}
