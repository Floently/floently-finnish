    {
      "card_id": "card.sentence.practical_nurse.hoitotyon-autonomia-ei-tarkoita-eristaytymista-muista-ammattiryhmista-vaan-kykya-tehda-itsenaisia-nayttoon-perustuvia-paatoksia-omalla-vastuualueella-samalla-kun-toimii-aktiivisest.b6c918",
      "source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "virtual_source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "card_index": 2,
      "content_type": "sentence_card",
      "field_path": "content.back.recall_prompt",
      "field_role": "recall_prompt",
      "source_language": "en",
      "source_hash": "sha256:f5899069b9bb8c49d524973f610e83ba2a9011c234e83fb4eae100ab920a1c80",
      "source_text": "Nursing autonomy does not mean isolation from other professional groups, but rather the ability to make independent, evidence-based decisions within one's own area of responsibility while actively participating in interprofessional collaboration. ->? (in Finnish)",
      "target_language": "ar",
      "localized_text": "استقلالية التمريض لا تعني العزلة عن المجموعات المهنية الأخرى، بل تعني القدرة على اتخاذ قرارات مستقلة قائمة على الأدلة ضمن نطاق المسؤولية الخاصة بالفرد مع المشاركة الفعالة في التعاون بين التخصصات.",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek",
      "provider_model": "deepseek-v4-flash",
      "risk_level": "low",
      "reason": "Back recall prompt is learner-facing instruction text.",
