      "source_language": "en",
      "source_hash": "sha256:8616c7fbc15fb8f1cc1673bb98e02961ff0426a3b0d20ebd83eda10e84345eb9",
      "source_text": "In international nursing collaboration, it is important to recognize cultural differences in health concepts, care practices, and professional roles so that collaboration is smooth and respectful. ->? (in Finnish)",
      "target_language": "zh-Hans",
      "localized_text": "在国际护理合作中，认识到健康观念、护理实践和专业角色中的文化差异非常重要，以便合作顺畅且尊重彼此。",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek_2",
      "provider_model": "deepseek-v4-flash",
      "risk_level": "low",
      "reason": "Back recall prompt is learner-facing instruction text.",
