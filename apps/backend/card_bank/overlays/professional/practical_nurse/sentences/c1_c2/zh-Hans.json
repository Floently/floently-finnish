      "source_hash": "sha256:ddc76c74183904ed50e227f98a1b94ceaaca564bc391ba7e8491e770bcafa58d",
      "source_text": "Clinical reasoning requires the ability to integrate theoretical knowledge, observations made about the patient's situation, and previous experience in order to form a comprehensive picture and make timely care decisions. ->? (in Finnish)",
      "target_language": "zh-Hans",
      "localized_text": "临床推理需要整合理论知识、对患者情况的观察以及以往经验的能力，以便形成全面的认识并及时做出护理决策。",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek_2",
      "provider_model": "deepseek-v4-flash",
