    {
      "card_id": "card.sentence.practical_nurse.hoitotyon-autonomia-ei-tarkoita-eristaytymista-muista-ammattiryhmista-vaan-kykya-tehda-itsenaisia-nayttoon-perustuvia-paatoksia-omalla-vastuualueella-samalla-kun-toimii-aktiivisest.b6c918",
