    {
      "card_id": "card.sentence.practical_nurse.hoitotyon-autonomia-ei-tarkoita-eristaytymista-muista-ammattiryhmista-vaan-kykya-tehda-itsenaisia-nayttoon-perustuvia-paatoksia-omalla-vastuualueella-samalla-kun-toimii-aktiivisest.b6c918",
      "source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "virtual_source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "card_index": 2,
      "content_type": "sentence_card",
      "field_path": "content.back.recall_prompt",
      "field_role": "recall_prompt",
      "source_language": "en",
      "source_hash": "sha256:f5899069b9bb8c49d524973f610e83ba2a9011c234e83fb4eae100ab920a1c80",
      "source_text": "Nursing autonomy does not mean isolation from other professional groups, but rather the ability to make independent, evidence-based decisions within one's own area of responsibility while actively participating in interprofessional collaboration. ->? (in Finnish)",
      "target_language": "zh-Hans",
      "localized_text": "护理自主权并不意味着与其他专业群体隔离，而是在自己的责任范围内独立做出基于证据的决策，同时积极参与跨专业合作。",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek_2",
      "provider_model": "deepseek-v4-flash",
      "risk_level": "low",
      "reason": "Back recall prompt is learner-facing instruction text.",
      "follow_up_index": null,
      "option_index": null,
      "option_id": null,
      "variant_type": null,
      "evaluation_mode": null,
      "translation_provider": "deepseek_direct",
      "translation_model": "deepseek-v4-flash",
      "updated_at_utc": "2026-05-14T04:07:38.783658+00:00"
    },
    {
      "card_id": "card.sentence.practical_nurse.hoitotyon-laatua-arvioitaessa-ei-riita-etta-toteutetut-toimenpiteet-on-dokumentoitu-asianmukaisesti-vaan-on-kyettava-osoittamaan-etta-ne-ovat-todella-edistaneet-potilaan-hyvinvoint.c98169",
      "source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "virtual_source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "card_index": 3,
      "content_type": "sentence_card",
      "field_path": "content.back.recall_prompt",
      "field_role": "recall_prompt",
      "source_language": "en",
      "source_hash": "sha256:8b3e47c5d2cbd489642668bf740ebfd1620b8cb4711c91ba9167b194eb137205",
      "source_text": "When evaluating the quality of nursing care, it is not enough that the implemented measures have been properly documented; rather, it must be demonstrated that they have truly promoted the patient's well-being and responded to their needs. ->? (in Finnish)",
      "target_language": "zh-Hans",
      "localized_text": "当评估护理质量时，仅仅记录已实施的措施是不够的；还必须证明这些措施确实促进了患者的健康并回应了他们的需求。",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek_2",
      "provider_model": "deepseek-v4-flash",
      "risk_level": "low",
      "reason": "Back recall prompt is learner-facing instruction text.",
      "follow_up_index": null,
      "option_index": null,
      "option_id": null,
      "variant_type": null,
      "evaluation_mode": null,
      "translation_provider": "deepseek_direct",
      "translation_model": "deepseek-v4-flash",
      "updated_at_utc": "2026-05-14T04:07:38.783670+00:00"
    },
    {
      "card_id": "card.sentence.practical_nurse.jotta-voimme-perustella-hoitotyon-kaytanteita-tutkitulla-tiedolla-meidan-on-kyettava-arvioimaan-kriittisesti-saatavilla-olevaa-tutkimusnayttoa-ja-soveltamaan-sita-yksilollisesti-ku.27f9b4",
      "source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "virtual_source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "card_index": 4,
      "content_type": "sentence_card",
      "field_path": "content.back.recall_prompt",
      "field_role": "recall_prompt",
      "source_language": "en",
      "source_hash": "sha256:41511ba1eaa9a3f0a8d6e473d6f917456405a9985b82b74bb6d42b598c8de8cd",
      "source_text": "In order to justify nursing practices with research evidence, we must be able to critically evaluate the available research evidence and apply it individually to each patient's situation. ->? (in Finnish)",
      "target_language": "zh-Hans",
      "localized_text": "为了用研究证据证明护理实践的合理性，我们必须能够批判性地评估现有的研究证据，并将其个别应用于每位患者的情况。",
      "translation_status": "translated",
      "review_status": "unreviewed",
      "provider": "deepseek_2",
      "provider_model": "deepseek-v4-flash",
      "risk_level": "low",
      "reason": "Back recall prompt is learner-facing instruction text.",
