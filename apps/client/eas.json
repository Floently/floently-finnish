{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://floently.com/learn/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://floently.com/learn/terms",
        "EXPO_PUBLIC_SUPPORT_URL": "https://floently.com/learn/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "https://floently.com/learn/delete-account",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "284679188970-2s1ta0tqmkn14ndgb369ls3f7u4tmgd5.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://floently.com/learn/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://floently.com/learn/terms",
        "EXPO_PUBLIC_SUPPORT_URL": "https://floently.com/learn/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "https://floently.com/learn/delete-account",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "284679188970-2s1ta0tqmkn14ndgb369ls3f7u4tmgd5.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "beta"
      }
    }
  }
