{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "/legal/privacy-policy",
        "EXPO_PUBLIC_TERMS_URL": "/legal/terms-of-use",
        "EXPO_PUBLIC_SUPPORT_URL": "/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "/legal/account-deletion"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "/legal/privacy-policy",
        "EXPO_PUBLIC_TERMS_URL": "/legal/terms-of-use",
        "EXPO_PUBLIC_SUPPORT_URL": "/support",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "/legal/account-deletion"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "beta"
      }
    }
  }
}
