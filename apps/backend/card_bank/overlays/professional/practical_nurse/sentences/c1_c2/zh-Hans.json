    },
    {
      "card_id": "card.sentence.practical_nurse.ennakoimalla-mahdollisia-komplikaatioita-ja-tunnistamalla-varhaiset-varoitusmerkit-pystymme-usein-ehkaisemaan-kriittisten-tilanteiden-kehittymisen.-by-anticipating-possible-complic.2afaea",
      "source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "virtual_source_file": "professional/practical_nurse/sentences/c1_c2.json",
      "card_index": 1,
