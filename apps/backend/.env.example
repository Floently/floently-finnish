# ── Application ──────────────────────────────────────────────────────────────────
# Values used by apps/backend/core/config.py
# Copy this file to .env and fill in real values before running locally.

FLOENTLY_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed CORS origins.
# In production, list only the exact origins your client is served from.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a strong random secret (min 32 chars).
SIGNED_SESSION_SECRET=change-me-to-a-strong-random-secret

# ── Engine ────────────────────────────────────────────────────────────────────────
# Base URL of the root YKI engine service.
YKI_ENGINE_BASE_URL=http://localhost:8010

# ── Stripe (optional) ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── TTS providers (optional) ─────────────────────────────────────────────────────
TTS_DEFAULT_PROVIDER=google
TTS_FALLBACK_PROVIDER=openai
GOOGLE_TTS_ENABLED=true
GOOGLE_TTS_LANGUAGE_CODE=fi-FI
# GOOGLE_TTS_CREDENTIALS_PATH=/absolute/path/to/google-credentials.json
OPENAI_API_KEY=

# ── Learning tuning ───────────────────────────────────────────────────────────────
DEFAULT_REVIEW_QUEUE_SIZE=12
DAILY_GOAL_ITEMS=20
\n
# ── AI evaluation ────────────────────────────────────────────────────────────────
# Detailed roleplay and YKI practice feedback. Keep disabled until the
# corresponding backend and client release has passed physical testing.
OPENAI_EVALUATION_ENABLED=false
OPENAI_EVALUATION_MODEL=gpt-4o-mini
OPENAI_EVALUATION_TIMEOUT=45
OPENAI_EVALUATION_MAX_TOKENS=1800
\n

# ── Professional roleplay identity validation ─────────────────────────────────
# Professional AI turns are validated before they can enter conversation history.
# If semantic validation is unavailable or uncertain, professional roleplay fails
# closed to a deterministic in-character counterpart response.
OPENAI_ROLEPLAY_SEMANTIC_VALIDATOR_ENABLED=true
OPENAI_ROLEPLAY_VALIDATOR_MODEL=gpt-4o-mini
OPENAI_ROLEPLAY_VALIDATOR_TIMEOUT=8
