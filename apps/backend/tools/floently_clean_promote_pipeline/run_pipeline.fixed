#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNSPEC_PATH="${1:-}"

if [[ -z "$RUNSPEC_PATH" ]]; then
  echo "Usage: ./run_pipeline path/to/runspec.env|json"
  exit 1
fi

if [[ ! -f "$RUNSPEC_PATH" ]]; then
  echo "Runspec file not found: $RUNSPEC_PATH"
  exit 1
fi

RUNSPEC_ABS="$(cd "$(dirname "$RUNSPEC_PATH")" && pwd)/$(basename "$RUNSPEC_PATH")"

PARSED="$(
python3 - "$RUNSPEC_ABS" <<'PY'
import json, os, sys
p = sys.argv[1]
ext = os.path.splitext(p)[1].lower()

def parse_env_style(path):
    result = {}
    with open(path, 'r', encoding='utf-8') as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith('#'):
                continue
            if '=' not in line:
                continue
            k, v = line.split('=', 1)
            result[k.strip()] = v.strip()
    return result

def parse_json(path):
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)

data = parse_json(p) if ext == '.json' else parse_env_style(p)

source = data.get('source') or data.get('input')
output = data.get('output')
config = data.get('config', '')
ai_mode = data.get('ai_mode', 'off')
model = data.get('model', '')
python_bin = data.get('python_bin', 'python')
venv_activate = data.get('venv_activate', '')
openai_api_key = data.get('OPENAI_API_KEY', '') or data.get('openai_api_key', '')
openai_api_key_file = data.get('OPENAI_API_KEY_FILE', '') or data.get('openai_api_key_file', '') or data.get('key_file', '')
extra_args = data.get('extra_args', '')

if not source:
    print('ERROR: missing source/input', file=sys.stderr)
    sys.exit(2)
if not output:
    print('ERROR: missing output', file=sys.stderr)
    sys.exit(2)

def emit(name, value):
    print(f"{name}={json.dumps('' if value is None else str(value))}")

emit('SOURCE', source)
emit('OUTPUT', output)
emit('CONFIG', config)
emit('AI_MODE', ai_mode)
emit('MODEL', model)
emit('PYTHON_BIN', python_bin)
emit('VENV_ACTIVATE', venv_activate)
emit('OPENAI_API_KEY', openai_api_key)
emit('OPENAI_API_KEY_FILE', openai_api_key_file)
emit('EXTRA_ARGS', extra_args)
PY
)"

eval "$PARSED"

cd "$SCRIPT_DIR"

if [[ -n "$VENV_ACTIVATE" ]]; then
  # shellcheck disable=SC1090
  source "$VENV_ACTIVATE"
elif [[ -f ".venv/bin/activate" ]]; then
  # shellcheck disable=SC1091
  source ".venv/bin/activate"
fi

if [[ -n "${OPENAI_API_KEY_FILE:-}" ]]; then
  if [[ ! -f "$OPENAI_API_KEY_FILE" ]]; then
    echo "OPENAI_API_KEY_FILE not found: $OPENAI_API_KEY_FILE"
    exit 1
  fi
  export OPENAI_API_KEY="$(tr -d '\r\n' < "$OPENAI_API_KEY_FILE")"
elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
  export OPENAI_API_KEY
fi

CMD=("$PYTHON_BIN" -m floently_pipeline.cli run --input "$SOURCE" --output "$OUTPUT")

if [[ -n "${CONFIG:-}" ]]; then
  CMD+=(--config "$CONFIG")
fi
if [[ -n "${AI_MODE:-}" ]]; then
  CMD+=(--ai-mode "$AI_MODE")
fi
if [[ -n "${MODEL:-}" ]]; then
  CMD+=(--model "$MODEL")
fi
if [[ -n "${OPENAI_API_KEY:-}" ]]; then
  CMD+=(--openai-api-key "$OPENAI_API_KEY")
fi
if [[ -n "${EXTRA_ARGS:-}" ]]; then
  read -r -a EXTRA_ARR <<< "$EXTRA_ARGS"
  CMD+=("${EXTRA_ARR[@]}")
fi

echo "Pipeline root: $SCRIPT_DIR"
echo "Source:        $SOURCE"
echo "Output:        $OUTPUT"
echo "AI mode:       $AI_MODE"
if [[ -n "${OPENAI_API_KEY_FILE:-}" ]]; then
  echo "Key file:      $OPENAI_API_KEY_FILE"
fi

exec "${CMD[@]}"
