    {
      "card_id": "card.sentence.practical_nurse.potilaan-itsemaaraamisoikeuden-kunnioittaminen-tarkoittaa-sita-etta-vaikka-emme-itse-tekisi-samaa-valintaa-meidan-on-hyvaksyttava-potilaan-tekema-paatos-kunhan-han-on-saanut-riitta.fd0c87",
